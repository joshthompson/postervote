{
  "name": "postervote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n convex,web -c magenta,cyan \"convex dev\" \"vite dev\"",
    "dev:web": "vite dev",
    "dev:convex": "convex dev",
    "build": "node scripts/build-font.mjs && node scripts/sync-posters.mjs --images-only && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "font": "node scripts/build-font.mjs",
    "map": "node scripts/build-map.mjs",
    "posters:sync": "node scripts/sync-posters.mjs",
    "posters:sync:prod": "dotenv -e .env.production -- node scripts/sync-posters.mjs --prod",
    "deploy:convex": "dotenv -e .env.production -- convex deploy",
    "deploy:web": "dotenv -e .env.production -- convex deploy --cmd-url-env-var-name PUBLIC_CONVEX_URL --cmd \"pnpm build\" && touch build/.nojekyll && gh-pages -d build --dotfiles",
    "ship": "pnpm deploy:web && pnpm posters:sync:prod"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "convex-svelte": "^0.14.0",
    "mixpanel-browser": "^2.83.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.0",
    "concurrently": "^10.0.5",
    "d3-geo": "^3.1.1",
    "dotenv-cli": "^11.0.0",
    "gh-pages": "^6.3.0",
    "i18n-iso-countries": "^7.14.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "world-atlas": "^2.0.2"
  }
}
